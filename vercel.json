{
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "installCommand": "bun install",
  "framework": "vite",
  "rewrites": [
    { "source": "/arcdex(.*)", "destination": "/arcdex.html" },
    { "source": "/whitepaper", "destination": "/whitepaper.html" },
    { "source": "/(.*)",       "destination": "/index.html"  }
  ]
}
