# ARCDEX market engine — environment. Copy to engine/.env (never commit it).
# Everything has a working default except the storage credentials.

# ── role & network ──────────────────────────────────────────────────────
# all (default): one process ingests the chain and serves clients.
# ingest / gateway: split them (needs REDIS_URL; events go over Redis pub/sub).
ENGINE_ROLE=all
PORT=8080
# Browsers from these origins may open the WebSocket / call the REST API.
WS_ALLOWED_ORIGINS=https://arcdex.online,https://www.arcdex.online
# Behind a proxy/load balancer (Fly, Railway, Render…): take the client IP
# from X-Forwarded-For for rate limits.
TRUST_PROXY=1

# ── Arc providers (failover order; add or reorder freely) ───────────────
# If a provider needs an API key, put it in the URL here — it stays server-side.
ARC_WS_URLS=wss://rpc.mainnet.arc.io,wss://rpc.drpc.mainnet.arc.io
ARC_HTTP_URLS=https://rpc.blockdaemon.mainnet.arc.io,https://rpc.mainnet.arc.io,https://rpc.beamrpc.com
ARC_LOGS_RECENT_URL=https://rpc.blockdaemon.mainnet.arc.io
ARC_LOGS_ARCHIVE_URLS=https://rpc.beamrpc.com,https://rpc.mainnet.arc.io,https://rpc.quicknode.mainnet.arc.io

# ── hot state (Redis) ───────────────────────────────────────────────────
# Any Redis 6+ (Upstash, Redis Cloud, self-hosted). rediss:// for TLS.
# Without it the engine keeps hot state in memory (dev only).
REDIS_URL=

# ── history ─────────────────────────────────────────────────────────────
# Either any Postgres (e.g. Railway: reference ${{Postgres.DATABASE_URL}}) —
# the engine creates its tables on first start —
DATABASE_URL=
# …or Supabase (run supabase/migrations/20260928000000_arcdex_market_engine.sql first).
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# HISTORY_ENABLED=0 to run without history.
HISTORY_TRADE_RETENTION_HOURS=72

# ── tuning (defaults shown) ─────────────────────────────────────────────
# First start with no saved cursor: replay this many blocks (~24h) so 24h stats are right.
BACKFILL_ON_START_BLOCKS=170000
# After downtime, never replay more than this (~3.5 days).
BACKFILL_MAX_BLOCKS=600000
RECONCILE_MS=1500
STALE_HEAD_MS=8000
WS_MAX_CONNS_PER_IP=10
WS_MAX_MSGS_PER_SEC=20
WS_MAX_SUBS_PER_CONN=100
REST_RATE_PER_SEC=20
# Bearer token required for /metrics (leave empty to make it public).
METRICS_TOKEN=
LOG_LEVEL=info
