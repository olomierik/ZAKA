# Supabase — copy from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Circle keys are set as Supabase Edge Function secrets in production.
# Only needed locally for the dev Bun server (not for Vercel frontend).
CIRCLE_DEVELOPER_CONTROLLED_API_KEY=TEST_API_KEY:id:secret
CIRCLE_ENTITY_SECRET=your-32-byte-hex-entity-secret

# ARCDEX contracts on Arc mainnet — set once deployed via scripts/deploy-mainnet.sh
# and scripts/deploy-launchpad.sh. Leave unset locally; SwapWidget/Launchpad
# degrade gracefully ("not deployed yet") without them.
VITE_ARCDEX_ROUTER_ADDRESS=
VITE_ARC_LAUNCHPAD_ADDRESS=

# Where the fees the site sets go (Relay and Across app fees, the bridge and launch fees; src/arcdex/lib/platform.ts).
# Empty: 0x2742…86Bb. The Across edge function reads it too. Set the engine's FEE_RECIPIENT_EVM to the same wallet.
VITE_FEE_RECIPIENT_EVM=

# Solana swaps through Jupiter's Swap API V2 (src/arcdex/lib/jupiter.ts). ARCDEX's 0.5% is Jupiter's referral fee,
# paid into token accounts of this referral account (create it on Jupiter's Ultra referral project at referral.jup.ag,
# with token accounts for SOL and USDC at least). Public: it's in every order. Empty: Jupiter swaps carry no ARCDEX fee.
VITE_JUP_REFERRAL_ACCOUNT=
# JUPITER_API_KEY (from developers.jup.ag) is a secret: set it only in Netlify's environment, where the edge function
# netlify/edge-functions/jupiter.ts adds it. Never in this file or a VITE_ variable. Without it, Solana swaps use Relay.

# Sign-in with email or a social account through Privy (src/arcdex/privy). The app id from dashboard.privy.io is public.
# Empty: the option isn't offered. Privy's app secret is never needed by the site: never put it here or in a VITE_ variable.
VITE_PRIVY_APP_ID=

# A dedicated Arc mainnet endpoint (QuickNode dashboard → the endpoint →
# HTTPS and WSS URLs). Tried first for reads, receipts and the live feeds,
# with the public RPC as fallback whenever it throttles or refuses. The URL
# carries its token and ships in the page: keep the endpoint's referrer
# whitelist on (arcdex.online, www.arcdex.online, localhost). Leave unset to
# use the public endpoints only.
VITE_ARC_RPC_URL=
VITE_ARC_WSS_URL=

# ArcDexCurveRouter: the deployed one (0xF8e8…6441, CURVE_ROUTER in
# api/_curves.ts) is the default, so Mercuri and SolonPad curve trades pay the
# 2% platform fee without this. Set another router's address to override it,
# or `off` to trade on the curve directly with no ARCDEX fee.
VITE_ARCDEX_CURVE_ROUTER_ADDRESS=

# Set once the platform's own token has been launched through the launchpad
# and you've started manually buying it back — powers the burn ticker in
# the top bar. Leave unset until then; the ticker just doesn't render.
VITE_ARC_PLATFORM_TOKEN_ADDRESS=
